def DetermineGreenHouseTemp(temp):
    if temp <= 10:
        print("The temp is low")
    elif temp >= 35:
        print("The Temp is high")
    else:
        print("The Temp is Good")
    return temp

def DetermineGreenHouseMoisture(moisture):
    if moisture <= 30:
        print("Nedds Water")
    else:
        print("No Water needed")
    return moisture


myTemp = float(input("What is the temp in the GreenHouse: "))
myMoisture = float(input("What is the moisture level: "))

greenHouseTemp = DetermineGreenHouseTemp(myTemp)
print(greenHouseTemp)
greenHouseMoisture = DetermineGreenHouseMoisture(myMoisture)
print(greenHouseMoisture)


